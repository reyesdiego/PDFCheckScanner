### A WebP upload, to confirm the format is read via golang.org/x/image
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="patio.webp"

< ./testdata/lossy.webp
--Boundary--

> {%
    client.test("webp is decoded and measured", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.image.content_type === "image/webp",
            "content_type " + response.body.image.content_type);
        client.assert(response.body.image.width === 150, "width " + response.body.image.width);
    });
%}

### A PDF with real form fields: answered exactly, from the AcroForm
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="form-fields.pdf"

< ./testdata/form-fields.pdf
--Boundary--
>

### The challenge description PDF: 7 flattened pages, no form fields
# Pages 1, 2 and 7 are prose and contain no checkboxes at all, so they are the
# false-positive canary: the detector should find almost nothing there. Pages
# 3-6 are the sample appraisal documents.
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="homevision.pdf"

< ./testdata/homevision.pdf
--Boundary--

> {%
    client.test("prose pages stay almost empty", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.method === "pixels", "method " + response.body.method);
        client.assert(response.body.image.pages === 7, "pages " + response.body.image.pages);

        const onProse = response.body.boxes.filter(d => [1, 2, 7].includes(d.page));
        client.assert(onProse.length === 0, "false positives on prose pages: " + onProse.length);
        // And the four form pages should still be full of real ones.
        const onForms = response.body.boxes.filter(d => ![1, 2, 7].includes(d.page));
        client.assert(onForms.length > 100, "only " + onForms.length + " on the form pages");
    });
%}

### A scanned PDF: no fields, so pdftoppm renders it and the detector runs
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="scan.pdf"

< ./testdata/scanned-form.pdf
--Boundary--

> {%
    client.test("scanned page falls back to the pixel detector", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.method === "pixels", "method " + response.body.method);
        const found = response.body.boxes;
        client.assert(found.length === 8, "found " + found.length);
        client.assert(found.filter(d => d.is_checked).length === 3,
            "checked " + found.filter(d => d.is_checked).length);
        client.assert(found.every(d => d.page === 1), "unexpected page number");
    });
%}

### A PDF whose form fields are invalid: falls through to the rasterizer
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="odd.pdf"

< ./testdata/scanned-broken-fields.pdf
--Boundary--

> {%
    client.test("unreadable fields do not fail the request", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.method === "pixels", "method " + response.body.method);
        client.assert(response.body.boxes.length === 8,
            "found " + response.body.boxes.length);
    });
%}

### Wrong field name -> 400
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="photo"; filename="form.png"

< ./testdata/form.png
--Boundary--

> {%
    client.test("the file field must be called image", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.error.includes("image"), response.body.error);
    });
%}


### A JSON body instead of an upload -> 400
POST {{host}}/detect
Content-Type: application/json

{
  "image_url": "https://example.com/form.png"
}

> {%
    client.test("only multipart uploads are accepted", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.error.includes("multipart/form-data"), response.body.error);
    });
%}

### Something that is not an image at all -> 415
# The declared part Content-Type says png; the sniffed bytes decide otherwise.
POST {{host}}/detect
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="image"; filename="not-an-image.png"
Content-Type: image/png

< ./testdata/gen_fixtures.py
--Boundary--

> {%
    client.test("the sniffed type wins over the declared one", function () {
        client.assert(response.status === 415, "status " + response.status);
        client.assert(response.body.error.includes("unsupported type"), response.body.error);
    });
%}

### GET is not routed -> 405
GET {{host}}/detect

> {%
    client.test("detect is POST only", function () {
        client.assert(response.status === 405, "status " + response.status);
    });
%}
